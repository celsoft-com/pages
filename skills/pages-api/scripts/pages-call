#!/usr/bin/env python3
"""Call a pages site's REST API. With no arguments it prints the site's OpenAPI document.

    pages-call                          # the API document: every tool, its method, schemas and level
    pages-call list_pages               # a tool that takes no arguments
    pages-call get_page args.json       # arguments from a file
    pages-call get_page -               # arguments from stdin

Arguments come from a file rather than the command line so a page of HTML never has to survive shell
quoting or land in the process list, and stdin is read only when asked for with `-`, so this can never
sit waiting on a pipe nobody is going to close. Whether a tool is a GET or a POST comes from the
site's own document, never from a list kept here.
"""

import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import pages_config  # noqa: E402

# Distinct exit codes so the caller branches on the failure instead of reading the sentence.
EXIT = {401: 3, 403: 4, 404: 5, 409: 6}
SAY = {
    401: "401, the token is unknown, expired or revoked. Run scripts/pages-doctor.",
    403: "403, this token is capped at read and the call writes.",
    404: "404: nothing there, or a path this token cannot reach, which looks the same.",
    409: "409, something changed since you read it. Re-read and reapply.",
}


def out(status, body):
    text = body.decode("utf-8", "replace")
    sys.stdout.write(text if text.endswith("\n") or not text else text + "\n")
    if 200 <= status < 300:
        return 0
    print(f"pages: {SAY.get(status, f'HTTP {status}')}", file=sys.stderr)
    return EXIT.get(status, 1)


def main(argv):
    try:
        site, token = pages_config.resolve()
    except pages_config.NotConfigured as error:
        print(error, file=sys.stderr)
        return 2

    status, body = pages_config.request(site, token, "GET", pages_config.OPENAPI_PATH)
    if len(argv) == 0:
        return out(status, body)
    if status != 200:
        return out(status, body)

    tool, source = argv[0], argv[1] if len(argv) > 1 else None
    operations = json.loads(body).get("paths", {}).get(f"/api/v1/{tool}", {})
    if not operations:
        print(f"pages: this site has no tool called {tool}. Run pages-call with no arguments for the API document.",
              file=sys.stderr)
        return 5
    method = next(iter(operations)).upper()

    args = {}
    if source == "-":
        text = sys.stdin.read()
        args = json.loads(text) if text.strip() else {}
    elif source:
        if not os.path.isfile(source):
            print(f"pages: no such file: {source}", file=sys.stderr)
            return 64
        with open(source, encoding="utf-8") as file:
            text = file.read()
        args = json.loads(text) if text.strip() else {}

    if method == "GET":
        encoded = pages_config.query(args)
        return out(*pages_config.request(site, token, "GET", f"/api/v1/{tool}" + (f"?{encoded}" if encoded else "")))
    return out(*pages_config.request(site, token, method, f"/api/v1/{tool}", body=args))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
