#!/usr/bin/env python3
"""Read-only diagnosis. Prints one KEY: VALUE per line so a caller branches without parsing prose,
changes nothing, and never prints the token."""

import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import pages_config  # noqa: E402


def main():
    print(f"CONFIG: {pages_config.CONFIG_FILE if os.path.isfile(pages_config.CONFIG_FILE) else 'none'}")
    print(f"ENV_SITE: {'set' if os.environ.get('PAGES_SITE_URL') else 'unset'}")
    print(f"ENV_TOKEN: {'set' if os.environ.get('PAGES_API_TOKEN') else 'unset'}")
    try:
        site, token = pages_config.resolve()
    except pages_config.NotConfigured:
        print("SITE: none")
        print("READY: no")
        print("FIX: run scripts/pages-login <site-url> with the token on stdin.")
        return 0

    print(f"SITE: {site}")
    print("TOKEN: present")
    try:
        status, body = pages_config.request(site, token, "GET", pages_config.OPENAPI_PATH, timeout=20)
    except OSError:
        status, body = 0, b""
    print(f"HTTP: {status:03d}")

    if 200 <= status < 300:
        paths = json.loads(body).get("paths", {})
        print(f"TOOLS: {sum(1 for path in paths if path.startswith('/api/v1/'))}")
        # The cap is what tells a call refused for a low cap from a path that is not there: both are 404.
        who_status, who = pages_config.request(site, token, "GET", pages_config.CALLER_PATH, timeout=20)
        if who_status == 200:
            caller = json.loads(who)
            print(f"ROLE: {(caller.get('user') or {}).get('role') or 'none'}")
            print(f"CAP: {caller.get('cap') or 'none'}")
        print("READY: yes")
    elif status == 401:
        print("READY: no")
        print("FIX: the token is unknown, expired or revoked. Make another at /tokens on the site, then run pages-login.")
    elif status == 0:
        print("READY: no")
        print("FIX: the site did not answer. Check the URL is the site's own address and that it is deployed.")
    elif status == 404:
        print("READY: no")
        print("FIX: no API document at that address. Check the URL, and that the site runs a version that serves one.")
    else:
        print("READY: no")
    return 0


if __name__ == "__main__":
    sys.exit(main())
