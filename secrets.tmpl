# The secrets scripts in this repo read from .env.secrets. Values are filled in by hand.
# The platform's own deploy tokens are declared by @celsoft/platform's setup, not here.

# Bearer tokens for the old pages sites, read by scripts/migrate-content.mjs with --token-env.
# Each is minted in that site's admin, under Connections, API tokens, and may be read-only.
SEAN_SITE_TOKEN={{ old site https://sean.celsoft.com: admin, Connections, API tokens }}
FAMILY_SITE_TOKEN={{ old site https://pages.odellfambly.us: admin, Connections, API tokens }}
